# Project-local xschem init, auto-sourced when xschem starts in this directory.
# No shell exports needed; just run `xschem <sch>` from here.
#
# Library path recipe copied from the vendor file
# (~/.local/share/pdk/sky130A/libs.tech/xschem/xschemrc): reset, then install
# xschem's own devices/ library FIRST (ipin/opin/lab_pin live there) plus the
# PDK symbol dir. The reset is deliberate: a lingering XSCHEM_LIBRARY_PATH
# export that names only the PDK silently drops the devices library, which is
# exactly the "devices load, pins don't" failure. PDK dir uses $HOME so this
# works on any machine with the standard ~/.local/share/pdk layout.
if {![info exists XSCHEM_SHAREDIR]} {
  set XSCHEM_SHAREDIR /usr/local/share/xschem
}
# EDIT POINT 1 — where your PDK's xschem symbols live. $HOME default fits the
# standard ~/.local/share/pdk layout; repoint this one line for other installs.
set _pdk_lib $env(HOME)/.local/share/pdk/sky130A/libs.tech/xschem
set XSCHEM_LIBRARY_PATH {}
append XSCHEM_LIBRARY_PATH :${XSCHEM_SHAREDIR}/xschem_library/devices
append XSCHEM_LIBRARY_PATH :${XSCHEM_SHAREDIR}/xschem_library
append XSCHEM_LIBRARY_PATH :$_pdk_lib
unset _pdk_lib
# project-local symbols (r2r_dac8_pdk, stair_stepper_*): xschem searches the
# library path, NOT the schematic's own directory. Anchor to this file's
# location so it works from any launch dir, plus the launch dir itself.
append XSCHEM_LIBRARY_PATH :[file dirname [info script]]/design/analog/xschem
append XSCHEM_LIBRARY_PATH :[pwd]
if {[info exists env(XSCHEM_USER_LIBRARY_PATH)]} {
  append XSCHEM_LIBRARY_PATH :$env(XSCHEM_USER_LIBRARY_PATH)
}
